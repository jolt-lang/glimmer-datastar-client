{:paths ["src"]

 ;; The client depends only on glimmer's portable core (ratoms, reconciler,
 ;; backend seam). Which toolkit draws is up to the app: it requires a backend
 ;; (glimmer-gtk.core, glimmer-tui.core, ...) and the client renders through it.
 :deps {jolt-lang/glimmer {:git/url "https://github.com/jolt-lang/glimmer"
                           :git/tag "v0.2.1"
                           :git/sha "a61f5ef71f56033c7a6765f400a5978ee76b7b6b"}
        ;; jolt.http.sse, the default transport
        jolt-lang/http-client {:git/url "https://github.com/jolt-lang/http-client"
                               :git/tag "v0.1.10"
                               :git/sha "bf1485ebd44b798d96306913ad800e76a9f58957"}}

 :aliases {:test {:extra-paths ["test" "examples"]
                  ;; real servers for the end-to-end tests: ring-chez for SSE,
                  ;; glimmer-datastar for the JSON example's signal parsing
                  :extra-deps {jolt-lang/ring-chez-adapter
                               {:git/url "https://github.com/jolt-lang/ring-chez-adapter"
                                :git/tag "v0.10.1"
                                :git/sha "387cf67ea7b6a8573c6ee6abca6026a45bc3b6bf"}
                               jolt-lang/glimmer-datastar
                               {:git/url "https://github.com/jolt-lang/glimmer-datastar"
                                :git/tag "v0.1.13"
                                :git/sha "52a3d441e8aee222fc393e8cbf43eeb354dde0ec"}}
                  :main-opts ["-m" "jolt.datastar.client.test-runner"]}

           ;; examples/: a JSON server and its thin client on GTK or the terminal
           :examples {:extra-paths ["examples"]
                      :extra-deps {jolt-lang/ring-chez-adapter
                                   {:git/url "https://github.com/jolt-lang/ring-chez-adapter"
                                    :git/tag "v0.10.1"
                                    :git/sha "387cf67ea7b6a8573c6ee6abca6026a45bc3b6bf"}
                                   jolt-lang/glimmer-datastar
                                   {:git/url "https://github.com/jolt-lang/glimmer-datastar"
                                    :git/tag "v0.1.13"
                                    :git/sha "52a3d441e8aee222fc393e8cbf43eeb354dde0ec"}
                                   jolt-lang/glimmer-gtk
                                   {:git/url "https://github.com/jolt-lang/glimmer-gtk"
                                    :git/tag "v0.2.2"
                                    :git/sha "3d46afcd1f0c50d26483dd8e20f76cb3433602a6"}
                                   jolt-lang/glimmer-tui
                                   {:git/url "https://github.com/jolt-lang/glimmer-tui"
                                    :git/tag "v0.3.2"
                                    :git/sha "a4a2623ecdfb997ddb22c215484b019d08f9ee52"}}}}

 :tasks {test "jolt -M:test"
         json-server "jolt -M:examples -m json-counter.server"
         json-gtk "jolt -M:examples -m json-counter.app gtk"
         json-tui "jolt -M:examples -m json-counter.app tui"}}
